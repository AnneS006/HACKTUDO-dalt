rules_version = '2';

// Demonstração sem login: quem tem o código da turma entra. O que se protege
// aqui é a integridade do que existe e o formato do que entra — não o acesso.
// Em produção, controlar a aula exigiria autenticação de professor.
service cloud.firestore {
  match /databases/{database}/documents {

    // O catálogo pode ser lido e semeado, mas nunca apagado: perder uma escola
    // ou uma turma derrubaria o app inteiro para todo mundo.
    match /escolas/{escola} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /turmas/{turma} {
      allow read, create, update: if true;
      allow delete: if false;

      // Perfil é só nome, cor, foto e disciplina. Nada sensível mora aqui.
      match /pessoas/{pessoa} {
        allow read, create, update: if true;
        allow delete: if false;
      }

      // Estado da aula: quem está em foco, o relógio e o contador agregado de
      // check-in. Não existe registro de humor por aluno, de propósito.
      match /sessao/{documento} {
        allow read, write: if true;

        match /respostas/{resposta} {
          allow read, delete: if true;
          allow update: if false;

          // A entrega só aceita os campos que o app envia, com teto de tamanho:
          // sem isso, o banco vira depósito de qualquer coisa.
          allow create: if request.resource.data.keys().hasOnly([
                'pessoaId', 'nome', 'tipo', 'criadaEm', 'materia',
                'texto', 'imagem', 'respostas', 'acertos', 'total',
                'opcao', 'palavras', 'peca'
              ])
              && (!('imagem' in request.resource.data)
                  || request.resource.data.imagem.size() < 800000)
              && (!('texto' in request.resource.data)
                  || request.resource.data.texto.size() < 5000)
              && (!('peca' in request.resource.data)
                  || request.resource.data.peca.size() < 5000);
        }
      }
    }
  }
}
