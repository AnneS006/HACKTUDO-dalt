rules_version = '2';

// Regras de demonstração: qualquer pessoa com o link entra. O que se protege
// aqui é o formato do dado, não o acesso — em produção entrariam App Check e
// autenticação de professor.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo da rede: é por ele que aluno e professor se encontram.
    match /escolas/{escola} {
      allow read, write: if true;
    }

    match /turmas/{turma} {
      allow read, write: if true;

      // Perfil é só nome, cor e foto. Nenhum dado sensível mora aqui.
      match /pessoas/{pessoa} {
        allow read, write: if true;
      }

      // Estado da aula: quem está em foco, o relógio e o contador agregado de
      // check-in. Não existe registro de humor por aluno, de propósito.
      match /sessao/{documento} {
        allow read, write: if true;

        // Entrega não pode ser alterada depois de enviada.
        match /respostas/{resposta} {
          allow read, create, delete: if true;
          allow update: if false;
        }
      }
    }
  }
}
